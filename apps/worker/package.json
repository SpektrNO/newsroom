{
  "name": "@newsroom/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@newsroom/ai": "workspace:*",
    "@newsroom/db": "workspace:*",
    "@newsroom/sources": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "ingest": "tsx src/index.ts ingest",
    "rank": "tsx src/index.ts rank",
    "test": "tsx --test --test-force-exit src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
