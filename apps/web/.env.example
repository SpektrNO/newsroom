# =============================================================================
# apps/web/.env.local — Next.js (web API + Rank latest + chat)
# =============================================================================
# Copy:  cp apps/web/.env.example apps/web/.env.local
#        then keep values in sync with the shared block in repo-root `.env`
#
# Next.js loads ONLY this file (and other apps/web/.env*). It does NOT read
# the repo-root `.env`. So Rank latest / Ollama / rank budgets here must match
# what you intend — setting RANK_BATCH_SIZE only in root `.env` has no effect
# on the Feed "Rank latest" button.
#
# Full map: docs/ops-local.md#environment-files
# =============================================================================

DATABASE_URL=postgres://newsroom:newsroom@localhost:5432/newsroom
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated extras (e.g. ngrok). Prefer setting BETTER_AUTH_URL to the
# public URL when tunneling; add localhost here if you still sign in locally too.
# BETTER_AUTH_TRUSTED_ORIGINS=https://abc123.ngrok-free.app
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
# RANK_MODEL_FAST=llama3.2
# RANK_MODEL_STANDARD=llama3.1:8b
# OLLAMA_TIMEOUT_MS=300000
# RANK_BATCH_SIZE=20
# AI_TOKEN_DAILY_LIMIT=200000
# AI_TOKEN_DAILY_SOFT_LIMIT=160000
# RANK_AI_MAX_PER_RUN=60
# RANK_AI_MAX_PER_DAY=0
# RANK_AI_MAX_GLOBAL_PER_DAY=0
# RANK_SCORE_TTL_DAYS=30
# RANK_SCORE_KEEP_TOP_N=500
# Article GC + feed/rank age window (0 = off). Default 90.
# ARTICLE_TTL_DAYS=90
# BLUESKY_APPVIEW_URL=https://public.api.bsky.app
