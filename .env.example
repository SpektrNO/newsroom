# GitHub issue / project scripts
GITHUB_REPO=SpektrNO/newsroom
GH_TOKEN=

# Optional: GitHub Projects V2 Status sync (see ./scripts/github-project-discover.sh)
# GITHUB_PROJECT_OWNER=SpektrNO
# GITHUB_PROJECT_NUMBER=1
# GITHUB_PROJECT_STATUS_FIELD=Status
# GITHUB_PROJECT_STATUS_TODO=Todo
# GITHUB_PROJECT_STATUS_IN_PROGRESS=In Progress
# GITHUB_PROJECT_STATUS_DONE=Done

# App — copy to .env and fill secrets
DATABASE_URL=postgres://newsroom:newsroom@localhost:5432/newsroom
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Generate timeout for ranking batches (ms). Default 300000 (5 min) — CPU needs headroom.
# OLLAMA_TIMEOUT_MS=300000
# Rank batch size (clamped 20–50; default 30). Use 20 on slow CPU.
# RANK_BATCH_SIZE=20
# Shared daily AI token budget (rank + chat). Soft defaults to 80% of hard.
# AI_TOKEN_DAILY_LIMIT=200000
# AI_TOKEN_DAILY_SOFT_LIMIT=160000
# Max articles AI-scored per user per rank run / UTC day (0 = unlimited).
# RANK_AI_MAX_PER_RUN=60
# RANK_AI_MAX_PER_DAY=200
# Optional global cap across all users per UTC day (0 = unlimited).
# RANK_AI_MAX_GLOBAL_PER_DAY=0
# Prune user_article_scores: TTL days + keep top-N new/seen by final_rank (saved kept).
# RANK_SCORE_TTL_DAYS=30
# RANK_SCORE_KEEP_TOP_N=500
# Mobile health probe (Expo)
EXPO_PUBLIC_API_URL=http://localhost:3000
