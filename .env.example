# =============================================================================
# Root `.env` — worker CLI, db scripts, GitHub tooling
# =============================================================================
# Copy:  cp .env.example .env
#
# Loaded by: `pnpm worker:*` / `pnpm --filter @newsroom/worker start`
#            (tsx --env-file=../../.env)
#
# NOT loaded by Next.js. For Rank latest, chat, Settings, health — also put the
# shared app vars into apps/web/.env.local (see apps/web/.env.example).
# Full map: docs/ops-local.md#environment-files
# =============================================================================

# --- GitHub issue / project scripts (root only) ---
GITHUB_REPO=SpektrNO/newsroom
GH_TOKEN=

# Optional: GitHub Projects V2 Status sync (see ./scripts/github-project-discover.sh)
# GITHUB_PROJECT_OWNER=SpektrNO
# GITHUB_PROJECT_NUMBER=1
# GITHUB_PROJECT_STATUS_FIELD=Status
# GITHUB_PROJECT_STATUS_TODO=Todo
# GITHUB_PROJECT_STATUS_IN_PROGRESS=In Progress
# GITHUB_PROJECT_STATUS_DONE=Done

# --- Shared app (copy these into apps/web/.env.local too) ---
DATABASE_URL=postgres://newsroom:newsroom@localhost:5432/newsroom
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# Optional: comma-separated Origins for tunnels (see docs/ops-local.md#auth-via-ngrok-or-other-tunnels)
# BETTER_AUTH_TRUSTED_ORIGINS=https://abc123.ngrok-free.app
# AI backend for rank + Advisor (default ollama). Same value in apps/web/.env.local.
# AI_PROVIDER=ollama|openai|google
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# Default is fast but a weak instruction-follower for rank "reason" text.
# Optional stronger alternatives (pull first): llama3.1:8b, qwen2.5:7b
# See docs/ops-local.md#model-options.
OLLAMA_MODEL=llama3.2
# OpenAI (when AI_PROVIDER=openai). Optional OPENAI_BASE_URL for compatible proxies.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Google Gemini (when AI_PROVIDER=google)
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_MODEL=gemini-2.0-flash
# Ranking model tiers (Settings → Ranking model): none | fast | standard.
# Resolution (see docs/ops-local.md#ranking-model-tiers):
#   RANK_MODEL_* always wins when set; else provider-aware defaults
#   (ollama: llama3.2 / llama3.1:8b; openai: gpt-4o-mini / gpt-4o;
#    google: gemini-2.0-flash).
#   none → keyword-only (no provider calls)
# Pull any Ollama model you reference before ranking with that tier.
# RANK_MODEL_FAST=llama3.2
# RANK_MODEL_STANDARD=llama3.1:8b
# Generate timeout for ranking batches (ms). Default 300000 (5 min) — CPU needs headroom.
# OLLAMA_TIMEOUT_MS=300000
# OPENAI_TIMEOUT_MS=300000
# GOOGLE_AI_TIMEOUT_MS=300000
# Rank batch size (clamped 20–50; default 30). Use 20 on slow CPU.
# Must be in apps/web/.env.local for Rank latest (web in-process rank).
# RANK_BATCH_SIZE=20
# Shared daily AI token budget (rank + chat). Soft defaults to 80% of hard.
# AI_TOKEN_DAILY_LIMIT=200000
# AI_TOKEN_DAILY_SOFT_LIMIT=160000
# Max articles AI-scored per user per rank run (keeps Rank latest bounded).
# Daily article cap defaults to unlimited (0); use AI_TOKEN_DAILY_LIMIT for cost.
# RANK_AI_MAX_PER_RUN=60
# RANK_AI_MAX_PER_DAY=0
# Optional global cap across all users per UTC day (0 = unlimited).
# RANK_AI_MAX_GLOBAL_PER_DAY=0
# Prune user_article_scores: TTL days + keep top-N new/seen by final_rank (saved kept).
# RANK_SCORE_TTL_DAYS=30
# RANK_SCORE_KEEP_TOP_N=500
# Delete ingested articles older than this many days (keeps any still saved). 0 = off.
# Also the feed/rank/pipeline age window (via feedMaxAgeCutoff). Default 90.
# ARTICLE_TTL_DAYS=90
# Bluesky public AppView base (no trailing slash). Default: https://public.api.bsky.app
# BLUESKY_APPVIEW_URL=https://public.api.bsky.app
# Reddit ingest (worker). Descriptive User-Agent is required by Reddit policy.
# REDDIT_USER_AGENT=newsroom:v1 (by /u/your_reddit_username)
# Public .json listings are often 403 — the adapter falls back to r/{sub}/.rss.
# Optional application-only OAuth (preferred when available):
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# --- Worker / seed only (root `.env`) ---
# SEED_USER_ID=
# NEWSROOM_WORKER_ONCE=ingest|rank|prune-scores

# --- Mobile (Expo) — apps/mobile reads EXPO_PUBLIC_* ---
EXPO_PUBLIC_API_URL=http://localhost:3000
